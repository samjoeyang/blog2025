<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ifanr</title>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="viewport" content="initial-scale=1, maximum-scale=3, minimum-scale=1, user-scalable=no">
  <meta name="MSSmartTagsPreventParsing" content="true"/>
  <meta http-equiv="imagetoolbar" content="no"/>
  <meta name="robots" content="all"/>
  <style>
    .ifr-404 {
      margin: 0 auto;
      text-align: center;
    }

    .ifr-404-header {
      background-color: #f8f8f8;
      padding-top: 16px;
      height: 86px;
      text-align: center;
    }

    .ifr-404-header img {
      width: 196px;
    }

    .ifr-404-box {
      margin-top: 130px;
    }

    .ifr-404-box .ifr-404-title {
      font-size: 80px;
      line-height: 80px;
      font-weight: bold;
      color: #dcdddd;
    }

    .ifr-404-box .ifr-404-divide {
      margin-top: -4px;
      margin-bottom: 24px;
    }

    .ifr-404-box .ifr-404-divide  span {
      display: inline-block;
      width: 110px;
      height: 1px;
      background-color: #dcdddd;
    }

    .ifr-404-box .ifr-404-des {
      font-size: 18px;
      color: #b5b5b6;
    }

    @media (max-width: 601px) {
      .ifr-404-box {
        margin-top: 75px;
      }

      .ifr-404-box .ifr-404-title {
        font-size: 54px;
        line-height: 54px;
      }

      .ifr-404-box .ifr-404-divide {
        margin-top: -4px;
        margin-bottom: 34px;
      }

      .ifr-404-box .ifr-404-divide  span {
        width: 70px;
      }

      .ifr-404-box .ifr-404-des {
        font-size: 12px;
      }
    }
  </style>
</head>
<body>

  <div class="ifr-404">
    <div class="ifr-404-header">
      <a href="http://www.ifanr.com">
        <img src="https://cdn.ifanr.cn/logo.png" alt="">
      </a>
    </div>

    <div class="ifr-404-box">
      <div class="ifr-404-title">404</div>
      <div class="ifr-404-divide"><span></span></div>
      <div class="ifr-404-des">
        抱歉，你请求的页面没有找到。
      </div>
    </div>
  </div>
</body>
</html>
