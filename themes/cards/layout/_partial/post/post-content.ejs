<% page.cover = false; %>

<div class="post-title">
    <h1 class="post-title__text">
        <%= page.title || theme.meta.title %>
    </h1>
    
    <div class="post-title__meta">
        <%- partial('_meta/date') %>
        <%- partial('_meta/categories') %> 
        <%- partial('_meta/speech') %>
        <%- partial('_plugins/statistics/index', {position: 'page'}) %> 
    </div>
</div>

<% if (theme.meta.toc.enable && page.toc !== false) { %>
    <aside class="post-side">
        <div class="post-side__toc">
            <%- toc(page.content, {list_number: (theme.meta.toc.list_number || false), max_depth: 6, min_depth: 2}) %>
        </div>
    </aside>
    <a class="btn-toc button" id="btn-toc" tabindex="0">
        <svg viewBox="0 0 1024 1024" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
            <path d="M128 256h64V192H128zM320 256h576V192H320zM128 544h64v-64H128zM320 544h576v-64H320zM128 832h64v-64H128zM320 832h576v-64H320z" fill="currentColor"></path>
        </svg>
    </a>
    <div class="toc-menus" id="toc-menus">
        <div class="toc-title"><%= __('post.toc') %></div>
        <%- toc(page.content, {list_number: (theme.meta.toc.list_number || false), max_depth: 6, min_depth: 2}) %>
    </div>
<% } %>

<article class="post<% if (theme.meta.toc.enable && page.toc !== false) { %> post__with-toc<% } %> content-card">
    <div class="post__header"><%- partial('_meta/thumbnail') %><%- partial('_meta/expire') %></div>


<script>
// --- 朗读功能 ---
var isSpeaking = false;
var isPaused = false;
var isAutoMode = false;
var speechSynth = window.speechSynthesis;
var speechUtterance = null;
var speechQueue = [];
var speechPartIndex = 0;

// 自动连播：页面加载时检查是否需自动朗读
(function(){
    if (sessionStorage.getItem('speech_autoplay') === '1') {
        sessionStorage.removeItem('speech_autoplay');
        // 等页面渲染完毕，再触发音量
        setTimeout(function() {
            var btn = document.getElementById('btn-speech');
            if (btn) btn.click();
        }, 500);
    }
})();

// 获取文章正文，分段朗读（每段不超过200字）
function getArticleSegments() {
    var el = document.getElementsByClassName('post__content')[0];
    if (!el) return [];
    var text = el.innerText.trim();
    if (!text) return [];
    // 按句号、问号、感叹号分段
    var segments = text.split(/(?<=[。！？\n])/);
    var result = [];
    var buf = '';
    for (var i = 0; i < segments.length; i++) {
        var s = segments[i].trim();
        if (!s) continue;
        if ((buf + s).length > 500) {
            if (buf) result.push(buf);
            buf = s;
        } else {
            buf += s;
        }
    }
    if (buf) result.push(buf);
    return result;
}

// 找到最佳的中文语音
function findBestChineseVoice() {
    var voices = speechSynth.getVoices();
    // 语音优先级：神经语音 > macOS Siri 语音 > 标准中文语音
    var priorityList = ['xiao', 'xiaoxiao', 'yunxi', 'yunyang', 
                        'zhong', 'mei-jia', 'meijia', 'ting-ting', 'tingting', 
                        'huihui', 'yaoyao', 'zhiyu', 'zeina', 'zira'];
    // 1. 按优先级找
    for (var p = 0; p < priorityList.length; p++) {
        for (var v = 0; v < voices.length; v++) {
            if (voices[v].lang.startsWith('zh') && 
                voices[v].name.toLowerCase().indexOf(priorityList[p]) !== -1) {
                return voices[v];
            }
        }
    }
    // 2. 找任意中文语音
    for (var v = 0; v < voices.length; v++) {
        if (voices[v].lang.startsWith('zh')) {
            return voices[v];
        }
    }
    // 3. 默认返回第一个可用语音
    return voices[0] || null;
}

function speakSegments(segments) {
    if (!segments || segments.length === 0) return;
    speechQueue = segments;
    speechPartIndex = 0;
    speakNextSegment();
}

function goToNextArticle() {
    var nextLink = document.querySelector('.nav__next a.nav__link');
    if (nextLink && nextLink.href) {
        sessionStorage.setItem('speech_autoplay', '1');
        window.location.href = nextLink.href;
    }
}

function speakNextSegment() {
    if (speechPartIndex >= speechQueue.length) {
        // 朗读完毕
        isSpeaking = false;
        isPaused = false;
        updateSpeechButton();
        // 自动跳到下一篇
        setTimeout(goToNextArticle, 1500);
        return;
    }
    
    var text = speechQueue[speechPartIndex];
    var msg = new SpeechSynthesisUtterance(text);
    msg.lang = 'zh-CN';
    msg.rate = 0.85;  // 稍慢，更清晰
    msg.pitch = 1.0;
    msg.volume = 1.0;
    
    var voice = findBestChineseVoice();
    if (voice) msg.voice = voice;
    
    msg.onend = function() {
        speechPartIndex++;
        if (isPaused) return;
        speakNextSegment();
    };
    
    msg.onerror = function() {
        isSpeaking = false;
        isPaused = false;
        updateSpeechButton();
    };
    
    speechUtterance = msg;
    speechSynth.speak(msg);
}

function toggleSpeech() {
    // 正在朗读 -> 暂停
    if (isSpeaking && !isPaused) {
        speechSynth.pause();
        isPaused = true;
        updateSpeechButton();
        return;
    }
    // 已暂停 -> 继续
    if (isSpeaking && isPaused) {
        speechSynth.resume();
        isPaused = false;
        updateSpeechButton();
        return;
    }
    // 之前有朗读记录 -> 继续
    if (speechQueue.length > 0 && speechPartIndex < speechQueue.length) {
        isSpeaking = true;
        isPaused = false;
        updateSpeechButton();
        speakNextSegment();
        return;
    }
    // 开始新的朗读
    var segments = getArticleSegments();
    if (segments.length === 0) return;
    if (speechSynth.getVoices().length === 0) {
        speechSynth.onvoiceschanged = function() {
            speechSynth.onvoiceschanged = null;
            isSpeaking = true;
            updateSpeechButton();
            speakSegments(segments);
        };
        speechSynth.getVoices();
        return;
    }
    isSpeaking = true;
    isPaused = false;
    updateSpeechButton();
    speakSegments(segments);
}

function updateSpeechButton() {
    var btn = document.getElementById('btn-speech');
    if (!btn) return;
    if (isSpeaking && isPaused) {
        btn.innerHTML = '▶️ 继续';
        btn.classList.add('speaking');
    } else if (isSpeaking) {
        btn.innerHTML = '⏹ 停止';
        btn.classList.add('speaking');
    } else {
        btn.innerHTML = '🎧 朗读';
        btn.classList.remove('speaking');
    }
}

// 页面离开时停止朗读
window.addEventListener('beforeunload', function() {
    if (speechSynth) speechSynth.cancel();
});
</script>


    <div class="post__content">
        <%- page.content %>
    </div>
    <%- partial('_meta/copyright') %> 
    <%- partial('_meta/updated') %> 
    <%- partial('_meta/tags') %> 
    <%- partial('_partial/post/share-buttons') %>


</article>

<% if (post.prev || post.next) { %>
    <div class="nav">
        <div class="nav__prev">
            <% if (post.prev) { %>
                <a href="<%= url_for(post.prev.path) %>" class="nav__link">
                    <div>
                        <svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><path d="M589.088 790.624L310.464 512l278.624-278.624 45.248 45.248L400.96 512l233.376 233.376z" fill="#808080"></path></svg>
                    </div>
                    <div>
                        <div class="nav__label">
                            <%= __('post.prev') %>
                        </div>
                        <div class="nav__title">
                            <%= post.prev.title || theme.meta.title %>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
        <div class="nav__next">
            <% if (post.next) { %>
                <a href="<%= url_for(post.next.path) %>" class="nav__link">
                    <div>
                        <div class="nav__label">
                            <%= __('post.next') %>
                        </div>
                        <div class="nav__title">
                            <%= post.next.title || theme.meta.title %>
                        </div>
                    </div>
                    <div>
                        <svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><path d="M434.944 790.624l-45.248-45.248L623.04 512l-233.376-233.376 45.248-45.248L713.568 512z" fill="#808080"></path></svg>
                    </div>
                </a>
            <% } %>
        </div>
    </div>
<% } %>

<% if (theme.comments.use && page.comments !== false) { %>
    <div class="post__comments<% if (theme.meta.toc.enable && page.toc !== false) { %> post__with-toc<% } %> content-card" id="comment">
        <%- partial('_plugins/comments/placeholder') %>
    </div>
<% } %>

