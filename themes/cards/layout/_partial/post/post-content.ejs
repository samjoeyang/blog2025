<% page.cover = false; %>

<div class="post-title">
    <h1 class="post-title__text">
        <%= page.title || theme.meta.title %>
    </h1>
    
    <div class="post-title__meta">
        <%- partial('_meta/date') %>
        <%- partial('_meta/categories') %> 
        <%- partial('_meta/speech') %>
        <%- partial('_plugins/statistics/index', {position: 'page'}) %> 
    </div>
</div>

<% if (theme.meta.toc.enable && page.toc !== false) { %>
    <aside class="post-side">
        <div class="post-side__toc">
            <%- toc(page.content, {list_number: (theme.meta.toc.list_number || false), max_depth: 6, min_depth: 2}) %>
        </div>
    </aside>
    <a class="btn-toc button" id="btn-toc" tabindex="0">
        <svg viewBox="0 0 1024 1024" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
            <path d="M128 256h64V192H128zM320 256h576V192H320zM128 544h64v-64H128zM320 544h576v-64H320zM128 832h64v-64H128zM320 832h576v-64H320z" fill="currentColor"></path>
        </svg>
    </a>
    <div class="toc-menus" id="toc-menus">
        <div class="toc-title"><%= __('post.toc') %></div>
        <%- toc(page.content, {list_number: (theme.meta.toc.list_number || false), max_depth: 6, min_depth: 2}) %>
    </div>
<% } %>

<article class="post<% if (theme.meta.toc.enable && page.toc !== false) { %> post__with-toc<% } %> content-card">
    <div class="post__header"><%- partial('_meta/thumbnail') %><%- partial('_meta/expire') %></div>


<script>
// ===== 朗读引擎 v3 —— 基于轮询的稳定方案 =====
var SPEECH = {
    syn: window.speechSynthesis,
    queue: [],              // 分段队列
    idx: 0,                 // 当前段索引
    speaking: false,        // 是否在朗读
    paused: false,          // 是否暂停
    timer: null,            // 轮询定时器
    voice: null,            // 选中的语音
    articleEndCb: null      // 读完回调
};

// ---- 自动连播 ----
(function(){
    if (sessionStorage.getItem('speech_autoplay') === '1') {
        sessionStorage.removeItem('speech_autoplay');
        setTimeout(function(){
            var btn = document.getElementById('btn-speech');
            if (btn) btn.click();
        }, 500);
    }
})();

function getArticleSegments() {
    var el = document.getElementsByClassName('post__content')[0];
    if (!el) return [];
    var text = el.innerText.trim();
    if (!text) return [];
    // 按句子切分，每段不超过 80 字
    var sents = text.split(/(?<=[。！？\n])/);
    var result = [], buf = '';
    for (var i = 0; i < sents.length; i++) {
        var s = sents[i].trim();
        if (!s) continue;
        if ((buf + s).length > 80) {
            if (buf) { result.push(buf); buf = ''; }
            while (s.length > 80) { result.push(s.slice(0,80)); s = s.slice(80); }
            buf = s;
        } else { buf += s; }
    }
    if (buf) result.push(buf);
    return result;
}

function pickVoice() {
    if (SPEECH.voice) return SPEECH.voice;
    var voices = SPEECH.syn.getVoices();
    var picks = ['xiaoxiao','xiao','yunxi','yunyang','zhong','mei-jia','meijia','ting-ting','tingting','huihui','yaoyao'];
    for (var p = 0; p < picks.length; p++) {
        for (var v = 0; v < voices.length; v++) {
            if (voices[v].lang.startsWith('zh') &&
                voices[v].name.toLowerCase().indexOf(picks[p]) !== -1) {
                SPEECH.voice = voices[v];
                return SPEECH.voice;
            }
        }
    }
    for (var v = 0; v < voices.length; v++) {
        if (voices[v].lang.startsWith('zh')) { SPEECH.voice = voices[v]; return SPEECH.voice; }
    }
    SPEECH.voice = voices[0] || null;
    return SPEECH.voice;
}

function goToNextArticle() {
    var link = document.querySelector('.nav__next a.nav__link');
    if (link && link.href) {
        sessionStorage.setItem('speech_autoplay', '1');
        window.location.href = link.href;
    }
}

function speechBtn(el) {
    if (!el) el = document.getElementById('btn-speech');
    if (!el) return;
    if (SPEECH.paused) {
        el.innerHTML = '▶️ 继续'; el.classList.add('speaking');
    } else if (SPEECH.speaking) {
        el.innerHTML = '⏹ 停止'; el.classList.add('speaking');
    } else {
        el.innerHTML = '🎧 朗读'; el.classList.remove('speaking');
    }
}

function pollSpeech() {
    if (SPEECH.paused) return;   // 暂停中，不操作
    if (SPEECH.syn.speaking) return;  // 还在朗读，继续等
    
    // 当前段读完了
    SPEECH.idx++;
    
    if (SPEECH.idx >= SPEECH.queue.length) {
        // 整篇文章读完了
        SPEECH.speaking = false;
        SPEECH.paused = false;
        clearInterval(SPEECH.timer);
        SPEECH.timer = null;
        speechBtn();
        setTimeout(goToNextArticle, 1500);
        return;
    }
    
    // 播下一段
    playSegment();
}

function playSegment() {
    if (SPEECH.idx >= SPEECH.queue.length) return;
    var text = SPEECH.queue[SPEECH.idx];
    var msg = new SpeechSynthesisUtterance(text);
    msg.lang = 'zh-CN';
    msg.rate = 0.85;
    msg.pitch = 1.0;
    msg.volume = 1.0;
    var v = pickVoice();
    if (v) msg.voice = v;
    
    // 开始轮询
    if (!SPEECH.timer) {
        SPEECH.timer = setInterval(pollSpeech, 300);
    }
    
    SPEECH.syn.speak(msg);
}

function toggleSpeech() {
    var btn = document.getElementById('btn-speech');
    
    // 暂停 -> 继续
    if (SPEECH.paused) {
        SPEECH.syn.resume();
        SPEECH.paused = false;
        if (!SPEECH.timer) {
            SPEECH.timer = setInterval(pollSpeech, 300);
        }
        speechBtn(btn);
        return;
    }
    
    // 朗读中 -> 暂停
    if (SPEECH.speaking) {
        SPEECH.syn.pause();
        SPEECH.paused = true;
        speechBtn(btn);
        return;
    }
    
    // 有未读完的队列 —> 继续
    if (SPEECH.queue.length > 0 && SPEECH.idx < SPEECH.queue.length) {
        SPEECH.speaking = true;
        SPEECH.paused = false;
        speechBtn(btn);
        playSegment();
        return;
    }
    
    // 开始新的朗读
    var segs = getArticleSegments();
    if (segs.length === 0) return;
    
    if (SPEECH.syn.getVoices().length === 0) {
        SPEECH.syn.onvoiceschanged = function() {
            SPEECH.syn.onvoiceschanged = null;
            SPEECH.queue = segs;
            SPEECH.idx = 0;
            SPEECH.speaking = true;
            SPEECH.paused = false;
            speechBtn(btn);
            playSegment();
        };
        SPEECH.syn.getVoices();
        return;
    }
    
    SPEECH.queue = segs;
    SPEECH.idx = 0;
    SPEECH.speaking = true;
    SPEECH.paused = false;
    speechBtn(btn);
    playSegment();
}

window.addEventListener('beforeunload', function() {
    if (SPEECH.timer) clearInterval(SPEECH.timer);
    SPEECH.syn.cancel();
});
</script>


    <div class="post__content">
        <%- page.content %>
    </div>
    <%- partial('_meta/copyright') %> 
    <%- partial('_meta/updated') %> 
    <%- partial('_meta/tags') %> 
    <%- partial('_partial/post/share-buttons') %>


</article>

<% if (post.prev || post.next) { %>
    <div class="nav">
        <div class="nav__prev">
            <% if (post.prev) { %>
                <a href="<%= url_for(post.prev.path) %>" class="nav__link">
                    <div>
                        <svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><path d="M589.088 790.624L310.464 512l278.624-278.624 45.248 45.248L400.96 512l233.376 233.376z" fill="#808080"></path></svg>
                    </div>
                    <div>
                        <div class="nav__label">
                            <%= __('post.prev') %>
                        </div>
                        <div class="nav__title">
                            <%= post.prev.title || theme.meta.title %>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
        <div class="nav__next">
            <% if (post.next) { %>
                <a href="<%= url_for(post.next.path) %>" class="nav__link">
                    <div>
                        <div class="nav__label">
                            <%= __('post.next') %>
                        </div>
                        <div class="nav__title">
                            <%= post.next.title || theme.meta.title %>
                        </div>
                    </div>
                    <div>
                        <svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><path d="M434.944 790.624l-45.248-45.248L623.04 512l-233.376-233.376 45.248-45.248L713.568 512z" fill="#808080"></path></svg>
                    </div>
                </a>
            <% } %>
        </div>
    </div>
<% } %>

<% if (theme.comments.use && page.comments !== false) { %>
    <div class="post__comments<% if (theme.meta.toc.enable && page.toc !== false) { %> post__with-toc<% } %> content-card" id="comment">
        <%- partial('_plugins/comments/placeholder') %>
    </div>
<% } %>

